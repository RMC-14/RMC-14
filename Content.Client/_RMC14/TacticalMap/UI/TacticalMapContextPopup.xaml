<local:TacticalMapContextPopup
    xmlns="https://spacestation14.io"
    xmlns:local="clr-namespace:Content.Client._RMC14.TacticalMap.UI"
    xmlns:controls="clr-namespace:Content.Client._RMC14.TacticalMap.Controls">
    <controls:TacticalMapPanel Kind="Popup" MinWidth="200">
        <BoxContainer Orientation="Vertical" SeparationOverride="4">
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <TextureRect Name="AreaIcon" SetSize="18 18" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                <controls:TacticalMapLabel Name="AreaNameLabel" TextStyle="Title" VAlign="Center" />
            </BoxContainer>
            <controls:TacticalMapDivider />
            <BoxContainer Name="InfoContainer" Orientation="Vertical" SeparationOverride="1" />
            <BoxContainer Name="ActionRow" Orientation="Horizontal" SeparationOverride="12" />
            <controls:TacticalMapDivider Name="ButtonDivider" />
            <BoxContainer Name="ButtonColumn" Orientation="Vertical" SeparationOverride="3">
                <controls:TacticalMapButton Name="CreateLabelButton" MinHeight="22" HorizontalExpand="True" />
                <controls:TacticalMapButton Name="CreateMortarButton" MinHeight="22" HorizontalExpand="True" />
                <controls:TacticalMapButton Name="DeleteMortarButton" Kind="Danger" MinHeight="22" HorizontalExpand="True" />
                <controls:TacticalMapButton Name="CopyCoordinatesButton" Kind="Flat" MinHeight="22" HorizontalExpand="True" />
            </BoxContainer>
        </BoxContainer>
    </controls:TacticalMapPanel>
</local:TacticalMapContextPopup>
