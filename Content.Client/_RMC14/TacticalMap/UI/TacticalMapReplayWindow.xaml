<ui:TacticalMapReplayWindow
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._RMC14.TacticalMap.UI"
    xmlns:controls="clr-namespace:Content.Client._RMC14.TacticalMap.Controls"
    SetSize="960 800" MinSize="520 420">
    <controls:TacticalMapPanel Kind="Window" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical">
            <controls:TacticalMapPanel Kind="Header">
                <BoxContainer Orientation="Horizontal" Margin="8 0 3 0" MinHeight="26" SeparationOverride="6">
                    <controls:TacticalMapLabel Name="HeaderTitle" TextStyle="Title" VAlign="Center" />
                    <controls:TacticalMapOptionButton Name="MapSelect" MinWidth="150" MinHeight="20"
                                                      VerticalAlignment="Center" Visible="False" />
                    <Control HorizontalExpand="True" />
                    <controls:TacticalMapButton Name="HeaderCloseButton" Kind="Danger" Text="{Loc ui-tactical-map-close-button}"
                                                MinWidth="24" MinHeight="20" VerticalAlignment="Center" />
                </BoxContainer>
            </controls:TacticalMapPanel>

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
                <Control HorizontalExpand="True" VerticalExpand="True" Margin="4">
                    <controls:TacticalMapLabel Name="EmptyLabel" Text="No tactical map recordings for this round."
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visible="False" />
                    <controls:TacticalMapControl Name="Map" HorizontalExpand="True" VerticalExpand="True" />
                </Control>
                <ScrollContainer HScrollEnabled="False" SetWidth="200" Margin="0 4 4 4">
                    <controls:TacticalMapSection Name="ChannelSection" Title="{Loc ui-tactical-map-section-channels}">
                        <BoxContainer Name="ChannelList" Orientation="Vertical" SeparationOverride="3" />
                    </controls:TacticalMapSection>
                </ScrollContainer>
            </BoxContainer>

            <controls:TacticalMapPanel Kind="Footer">
                <BoxContainer Orientation="Horizontal" Margin="6 4" SeparationOverride="4">
                    <controls:TacticalMapButton Name="PlayButton" Kind="Primary" MinWidth="64" MinHeight="22" />
                    <controls:TacticalMapButton Name="SpeedButton" MinWidth="52" MinHeight="22" />
                    <Slider Name="Timeline" HorizontalExpand="True" MinValue="0" MaxValue="1" Margin="6 0"
                            MinHeight="14" VerticalAlignment="Center" />
                    <controls:TacticalMapLabel Name="TimeLabel" TextStyle="Small" MinWidth="130" VAlign="Center" />
                </BoxContainer>
            </controls:TacticalMapPanel>
        </BoxContainer>
    </controls:TacticalMapPanel>
</ui:TacticalMapReplayWindow>
