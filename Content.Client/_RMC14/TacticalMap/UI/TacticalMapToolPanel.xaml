<ui:TacticalMapToolPanel
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._RMC14.TacticalMap.UI"
    xmlns:controls="clr-namespace:Content.Client._RMC14.TacticalMap.Controls"
    Orientation="Vertical" SeparationOverride="4" SetWidth="156" Margin="4 4 0 4">
    <controls:TacticalMapSection Name="TargetSection" Title="{Loc ui-tactical-map-section-draw-target}" Visible="False">
        <controls:TacticalMapOptionButton Name="DrawTargetButton" HorizontalExpand="True" MinHeight="22" />
    </controls:TacticalMapSection>

    <controls:TacticalMapSection Title="{Loc ui-tactical-map-section-tools}">
        <GridContainer Columns="2" HSeparationOverride="3" VSeparationOverride="3" HorizontalExpand="True">
            <controls:TacticalMapButton Name="PenButton" Text="{Loc ui-tactical-map-tool-pen}"
                                        HorizontalExpand="True" MinHeight="22" />
            <controls:TacticalMapButton Name="LineButton" Text="{Loc ui-tactical-map-tool-line}"
                                        HorizontalExpand="True" MinHeight="22" />
            <controls:TacticalMapButton Name="RectangleButton" Text="{Loc ui-tactical-map-tool-rectangle}"
                                        HorizontalExpand="True" MinHeight="22" />
            <controls:TacticalMapButton Name="EraserButton" Text="{Loc ui-tactical-map-tool-eraser}"
                                        HorizontalExpand="True" MinHeight="22" />
            <controls:TacticalMapButton Name="LabelButton" Text="{Loc ui-tactical-map-tool-label}"
                                        HorizontalExpand="True" MinHeight="22" />
        </GridContainer>
    </controls:TacticalMapSection>

    <controls:TacticalMapSection Name="ColorSection" Title="{Loc ui-tactical-map-section-colour}">
        <GridContainer Name="ColorsContainer" Columns="4" HSeparationOverride="4" VSeparationOverride="4"
                       HorizontalAlignment="Center" />
    </controls:TacticalMapSection>

    <controls:TacticalMapSection Name="WidthSection" Title="{Loc ui-tactical-map-section-width}">
        <Slider Name="ThicknessSlider" MinValue="1" MaxValue="8" Value="2" HorizontalExpand="True" MinHeight="14" />
    </controls:TacticalMapSection>

    <Control VerticalExpand="True" />

    <controls:TacticalMapSection Title="{Loc ui-tactical-map-section-actions}">
        <BoxContainer Orientation="Vertical" SeparationOverride="4">
            <BoxContainer Orientation="Horizontal" SeparationOverride="3">
                <controls:TacticalMapButton Name="UndoButton" Text="{Loc ui-tactical-map-undo-button}"
                                            HorizontalExpand="True" MinHeight="22" />
                <controls:TacticalMapButton Name="ClearButton" Kind="Danger" Text="{Loc ui-tactical-map-clear-button}"
                                            HorizontalExpand="True" MinHeight="22" />
            </BoxContainer>
            <controls:TacticalMapButton Name="UpdateButton" Access="Public" Kind="Primary"
                                        Text="{Loc ui-tactical-map-update-button}"
                                        HorizontalExpand="True" MinHeight="28" />
            <ProgressBar Name="CooldownBar" Visible="False" HorizontalExpand="True" MinHeight="16">
                <controls:TacticalMapLabel Name="CooldownLabel" TextStyle="Small"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ProgressBar>
        </BoxContainer>
    </controls:TacticalMapSection>
</ui:TacticalMapToolPanel>
