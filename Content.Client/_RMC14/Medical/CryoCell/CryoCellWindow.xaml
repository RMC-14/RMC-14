<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    MinSize="500 800">
    <BoxContainer Orientation="Vertical">
        <!-- Empty State -->
        <BoxContainer Name="EmptyPanel" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
            <Control VerticalExpand="True" />
            <Label Text="{Loc rmc-cryocell-no-occupant}" Align="Center" StyleClasses="LabelBig" />
            <Control VerticalExpand="True" />
        </BoxContainer>

        <!-- Occupant State -->
        <BoxContainer Name="OccupantPanel" Orientation="Vertical" Visible="False">
            <!-- Occupant Section -->
            <BoxContainer Orientation="Vertical">
                <Label Text="{Loc rmc-cryocell-occupant-header}" StyleClasses="LabelKeyText" Margin="0 0 0 5" />
                <cc:HSeparator Color="#4972A1" Margin="0 5 0 5" />
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Label Text="{Loc rmc-cryocell-name-label}" MinWidth="120" Modulate="#5B88B0" />
                    <Label Name="OccupantNameLabel" Text="" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Label Text="{Loc rmc-cryocell-status-label}" MinWidth="120" Modulate="#5B88B0" />
                    <Label Name="StatusLabel" Text="" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Label Text="{Loc rmc-cryocell-temperature}" MinWidth="120" Modulate="#5B88B0" />
                    <Label Name="TemperatureLabel" Text="" />
                </BoxContainer>
                <!-- Health Bars -->
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Label Text="{Loc rmc-cryocell-health-label}" MinWidth="120" Modulate="#5B88B0" />
                    <ProgressBar Name="HealthBar" HorizontalExpand="True" MinValue="0" MinHeight="16">
                        <Label Name="HealthBarText" Align="Right" Margin="0 0 5 0" />
                    </ProgressBar>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Label Text="{Loc rmc-cryocell-brute}" MinWidth="120" Modulate="#5B88B0" />
                    <ProgressBar Name="BruteBar" HorizontalExpand="True" MinValue="0" MaxValue="100" MinHeight="16">
                        <Label Name="BruteBarText" Align="Right" Margin="0 0 5 0" />
                    </ProgressBar>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Label Text="{Loc rmc-cryocell-burn}" MinWidth="120" Modulate="#5B88B0" />
                    <ProgressBar Name="BurnBar" HorizontalExpand="True" MinValue="0" MaxValue="100" MinHeight="16">
                        <Label Name="BurnBarText" Align="Right" Margin="0 0 5 0" />
                    </ProgressBar>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Label Text="{Loc rmc-cryocell-toxin}" MinWidth="120" Modulate="#5B88B0" />
                    <ProgressBar Name="ToxinBar" HorizontalExpand="True" MinValue="0" MaxValue="100" MinHeight="16">
                        <Label Name="ToxinBarText" Align="Right" Margin="0 0 5 0" />
                    </ProgressBar>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Label Text="{Loc rmc-cryocell-oxygen}" MinWidth="120" Modulate="#5B88B0" />
                    <ProgressBar Name="OxygenBar" HorizontalExpand="True" MinValue="0" MaxValue="100" MinHeight="16">
                        <Label Name="OxygenBarText" Align="Right" Margin="0 0 5 0" />
                    </ProgressBar>
                </BoxContainer>
            </BoxContainer>

            <!-- Cell Section -->
            <BoxContainer Orientation="Vertical">
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Button Name="PowerButton" Text="{Loc rmc-cryocell-toggle-power}" MinWidth="120" />
                    <Control HorizontalExpand="True" />
                    <Button Name="AutoEjectButton" Text="{Loc rmc-cryocell-auto-eject}" ToggleMode="True" MinWidth="120" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Button Name="NotifyButton" Text="{Loc rmc-cryocell-notify}" ToggleMode="True" MinWidth="120" />
                    <Control HorizontalExpand="True" />
                    <Button Name="EjectButton" Text="{Loc rmc-cryocell-eject}" MinWidth="120" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                    <Control HorizontalExpand="True" />
                    <Button Name="EjectBeakerButton" Text="{Loc rmc-cryocell-eject-beaker}" MinWidth="120" />
                </BoxContainer>
            </BoxContainer>

            <!-- Beaker Section -->
            <BoxContainer Orientation="Vertical">
                <!-- TODO BEAKER SECTION -->
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
