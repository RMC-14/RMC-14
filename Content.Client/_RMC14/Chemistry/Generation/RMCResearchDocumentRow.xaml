<controls:RMCResearchDocumentRow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Chemistry.Generation"
    Orientation="Horizontal"
    HorizontalExpand="True"
    SeparationOverride="4"
    Margin="0 0 0 2">
    <Label Name="ScanTimeLabel" Access="Public" MinWidth="100" FontColorOverride="#C69214" />
    <Label Name="TypeLabel" Access="Public" MinWidth="140" FontColorOverride="#C69214" />
    <Label Name="CompoundLabel" Access="Public" HorizontalExpand="True" FontColorOverride="#C69214" />
    <Button Name="ReadButton" Access="Public" MinWidth="90" />
    <Button Name="PrintButton" Access="Public" MinWidth="90" />
    <Button Name="AnnounceButton" Access="Public" MinWidth="90" />
    <Button Name="PublishButton" Access="Public" MinWidth="80" Text="Publish" />
</controls:RMCResearchDocumentRow>
