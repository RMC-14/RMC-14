<controls:RMCCentrifugeWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Chemistry.Centrifuge"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="Chemical Centrifuge" MinSize="320 300">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#181C24" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="4">
            <PanelContainer Name="ControlsHeader" Access="Public">
                <Label Text="Centrifuge controls" FontColorOverride="#FFFFFF" Margin="6 2" />
            </PanelContainer>

            <BoxContainer Orientation="Horizontal" Margin="0 5 0 0">
                <Label Text="Label:" Margin="0 0 5 0" FontColorOverride="#C7CCD6" />
                <LineEdit Name="LabelEdit" Access="Public" PlaceHolder="No label" HorizontalExpand="True" />
            </BoxContainer>

            <Button Name="ModeButton" Access="Public" HorizontalExpand="True" Margin="0 5 0 0" />
            <Button Name="SourceButton" Access="Public" HorizontalExpand="True" Margin="0 3 0 0" />
            <Button Name="ConnectButton" Access="Public" HorizontalExpand="True" Margin="0 3 0 0" />

            <PanelContainer Name="ConnectionPanel" Access="Public" Margin="0 5 0 0">
                <Label Name="ConnectionLabel" Access="Public" Margin="6 2" />
            </PanelContainer>

            <PanelContainer Name="SettingsHeader" Access="Public" Margin="0 6 0 0">
                <Label Text="Settings" FontColorOverride="#FFFFFF" Margin="6 2" />
            </PanelContainer>
            <BoxContainer Orientation="Horizontal" Margin="0 5 0 0">
                <Label Text="Input:" MinWidth="60" FontColorOverride="#C7CCD6" />
                <Label Name="InputStatusLabel" Access="Public" HorizontalExpand="True" FontColorOverride="#C7CCD6" />
                <Button Name="EjectInputButton" Access="Public" Text="Eject" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" Margin="0 3 0 0">
                <Label Text="Output:" MinWidth="60" FontColorOverride="#C7CCD6" />
                <Label Name="OutputStatusLabel" Access="Public" HorizontalExpand="True" FontColorOverride="#C7CCD6" />
                <Button Name="EjectOutputButton" Access="Public" Text="Eject" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:RMCCentrifugeWindow>
