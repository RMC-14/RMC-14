<controls:RMCAdminCommendationWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Admin.Commendations"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc rmc-give-commendation-title}"
    MinSize="600 500">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#141414" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="8">
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc rmc-give-commendation-giver}" MinWidth="145" />
                <LineEdit Name="GiverEdit" Access="Public" HorizontalExpand="True" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Control MinWidth="145" />
                <Button Name="HighCommandButton" Access="Public"
                        Text="{Loc rmc-give-commendation-preset-highcommand}"
                        StyleClasses="OpenBoth" />
                <Button Name="QueenMotherButton" Access="Public"
                        Text="{Loc rmc-give-commendation-preset-queenmother}"
                        StyleClasses="OpenBoth" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc rmc-give-commendation-receiver}" MinWidth="145" />
                <LineEdit Name="ReceiverEdit" Access="Public" HorizontalExpand="True" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Control MinWidth="145" />
                <BoxContainer Name="PlayerSuggestions" Access="Public" Orientation="Vertical"
                              HorizontalExpand="True" Visible="False" SeparationOverride="2" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc rmc-give-commendation-receiver-name}" MinWidth="145" />
                <LineEdit Name="ReceiverNameEdit" Access="Public" HorizontalExpand="True" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc rmc-give-commendation-type}" MinWidth="145" />
                <CheckButton Name="MedalButton" Access="Public"
                             Text="{Loc rmc-give-commendation-type-medal}"
                             StyleClasses="OpenBoth" ToggleMode="True" />
                <CheckButton Name="JellyButton" Access="Public"
                             Text="{Loc rmc-give-commendation-type-jelly}"
                             StyleClasses="OpenBoth" ToggleMode="True" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc rmc-give-commendation-award}" MinWidth="145" />
                <OptionButton Name="AwardOption" Access="Public" HorizontalExpand="True" />
            </BoxContainer>
            <RichTextLabel Name="PreviewTitle" Access="Public" HorizontalExpand="True" />
            <RichTextLabel Name="PreviewDescription" Access="Public" HorizontalExpand="True" />
            <Label Text="{Loc rmc-give-commendation-citation}" />
            <PanelContainer VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat
                        BackgroundColor="#1F1F1F"
                        BorderColor="#3A3A3A"
                        BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <TextEdit Name="CitationEdit" Access="Public" VerticalExpand="True" MinHeight="120" Margin="4" />
            </PanelContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc rmc-give-commendation-round}" MinWidth="145" />
                <LineEdit Name="RoundEdit" Access="Public" MinWidth="100" />
                <Label Text="{Loc rmc-give-commendation-round-hint}" Margin="6 0 0 0" />
            </BoxContainer>
            <RichTextLabel Name="ErrorLabel" Access="Public" />
            <Button Name="SubmitButton" Access="Public"
                    Text="{Loc rmc-give-commendation-submit}"
                    StyleClasses="OpenBoth" />
        </BoxContainer>
    </PanelContainer>
</controls:RMCAdminCommendationWindow>
