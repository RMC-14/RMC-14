<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc rmc-orbital-drop-title}"
    SetSize="1000 700"
    MinSize="920 600">
    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
        <BoxContainer Orientation="Vertical" MinWidth="480" HorizontalExpand="True">
            <Label Text="{Loc rmc-orbital-drop-payload-sources}" StyleClasses="LabelHeading" />
            <TabContainer Name="PayloadTabs" VerticalExpand="True">
                <BoxContainer Name="NearbyTab" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-nearby-radius}" MinWidth="130" />
                        <SpinBox Name="NearbyRadius" Access="Public" Value="7" HorizontalExpand="True" />
                        <Button Name="RefreshNearby" Access="Public" Text="{Loc rmc-orbital-drop-refresh}" />
                    </BoxContainer>
                    <LineEdit Name="NearbySearch"
                              Access="Public"
                              PlaceHolder="{Loc rmc-orbital-drop-search-entities}" />
                    <ItemList Name="NearbyEntities" Access="Public" SelectMode="Multiple" VerticalExpand="True" />
                    <BoxContainer Orientation="Horizontal">
                        <Button Name="SelectAllNearby"
                                Access="Public"
                                Text="{Loc rmc-orbital-drop-select-all}"
                                HorizontalExpand="True" />
                        <Button Name="AddNearby"
                                Access="Public"
                                Text="{Loc rmc-orbital-drop-add-selected}"
                                HorizontalExpand="True" />
                    </BoxContainer>
                </BoxContainer>
                <BoxContainer Name="PlayerTab" Orientation="Vertical">
                    <LineEdit Name="PlayerSearch"
                              Access="Public"
                              PlaceHolder="{Loc rmc-orbital-drop-search-player-controlled}" />
                    <ItemList Name="PlayerEntities" Access="Public" SelectMode="Single" VerticalExpand="True" />
                    <Button Name="AddPlayer" Access="Public" Text="{Loc rmc-orbital-drop-add-selected}" />
                </BoxContainer>
                <BoxContainer Name="PrototypeTab" Orientation="Vertical">
                    <LineEdit Name="PrototypeSearch"
                              Access="Public"
                              PlaceHolder="{Loc rmc-orbital-drop-search-prototypes}" />
                    <ItemList Name="Prototypes" Access="Public" SelectMode="Single" VerticalExpand="True" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-quantity}" MinWidth="130" />
                        <SpinBox Name="PrototypeQuantity" Access="Public" Value="1" HorizontalExpand="True" />
                        <Button Name="AddPrototype" Access="Public" Text="{Loc rmc-orbital-drop-add-prototype}" />
                    </BoxContainer>
                </BoxContainer>
            </TabContainer>
        </BoxContainer>

        <BoxContainer Orientation="Vertical" MinWidth="420" HorizontalExpand="True">
            <Label Text="{Loc rmc-orbital-drop-manifest}" StyleClasses="LabelHeading" />
            <ItemList Name="Manifest" Access="Public" SelectMode="Single" MinHeight="160" VerticalExpand="True" />
            <BoxContainer Orientation="Horizontal">
                <Button Name="RemoveManifestEntry"
                        Access="Public"
                        Text="{Loc rmc-orbital-drop-remove-selected}"
                        HorizontalExpand="True" />
                <Button Name="ClearManifest"
                        Access="Public"
                        Text="{Loc rmc-orbital-drop-clear-manifest}"
                        HorizontalExpand="True" />
            </BoxContainer>
            <Label Name="ManifestSummary" Access="Public" />

            <ScrollContainer VerticalExpand="True">
                <BoxContainer Orientation="Vertical">
                    <Label Text="{Loc rmc-orbital-drop-landing}" StyleClasses="LabelHeading" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-map}" MinWidth="190" />
                        <OptionButton Name="MapOptions" Access="Public" HorizontalExpand="True" />
                    </BoxContainer>
                    <CheckBox Name="RawCoordinates" Access="Public"
                              Text="{Loc rmc-orbital-drop-raw-coordinates}"
                              ToolTip="{Loc rmc-orbital-drop-raw-coordinates-tooltip}" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-x}" MinWidth="190" />
                        <SpinBox Name="MapX" Access="Public" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-y}" MinWidth="190" />
                        <SpinBox Name="MapY" Access="Public" HorizontalExpand="True" />
                    </BoxContainer>
                    <Button Name="UseCurrentPosition"
                            Access="Public"
                            Text="{Loc rmc-orbital-drop-use-current-position}" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-landing-radius}" MinWidth="190" />
                        <SpinBox Name="LandingRadius" Access="Public" Value="3" HorizontalExpand="True" />
                    </BoxContainer>
                    <CheckBox Name="IgnoreParadropRestrictions" Access="Public"
                              Text="{Loc rmc-orbital-drop-ignore-paradrop-restrictions}"
                              ToolTip="{Loc rmc-orbital-drop-ignore-paradrop-restrictions-tooltip}" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-pod-count}" MinWidth="190" />
                        <SpinBox Name="PodCount" Access="Public" Value="1" HorizontalExpand="True" />
                    </BoxContainer>

                    <Label Text="{Loc rmc-orbital-drop-timing}" StyleClasses="LabelHeading" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-launch-interval}" MinWidth="190" />
                        <FloatSpinBox Name="LaunchInterval" Access="Public" Value="0.2" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-arrival-delay}" MinWidth="190" />
                        <FloatSpinBox Name="ArrivalDelay" Access="Public" Value="5" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-minimum-drop-spacing}" MinWidth="190" />
                        <FloatSpinBox Name="DropInterval" Access="Public" Value="0.2" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-drop-spacing-variation}" MinWidth="190" />
                        <FloatSpinBox Name="DropIntervalVariation" Access="Public" Value="0" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-drop-duration}" MinWidth="190" />
                        <FloatSpinBox Name="DropDuration" Access="Public" Value="3" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc rmc-orbital-drop-open-delay}" MinWidth="190" />
                        <FloatSpinBox Name="OpenDelay" Access="Public" Value="2" HorizontalExpand="True" />
                    </BoxContainer>
                    <CheckBox Name="UseParachute"
                              Access="Public"
                              Text="{Loc rmc-orbital-drop-use-parachute}"
                              Pressed="True" />
                </BoxContainer>
            </ScrollContainer>

            <Label Name="Result" Access="Public" />
            <Button Name="Launch" Access="Public" Text="{Loc rmc-orbital-drop-launch}" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
