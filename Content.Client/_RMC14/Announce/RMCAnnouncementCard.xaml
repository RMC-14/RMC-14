<Control xmlns="https://spacestation14.io"
         xmlns:announce="clr-namespace:Content.Client._RMC14.Announce"
         MouseFilter="Ignore">
    <PanelContainer Name="Background" MouseFilter="Ignore">
        <announce:RMCAnnouncementShaderRect Name="BackgroundShader"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="12" Margin="10 8 10 8" MouseFilter="Ignore">
            <AnimatedTextureRect Name="Decal" Visible="False" VerticalAlignment="Center" MouseFilter="Ignore"/>
            <PanelContainer Name="PortraitFrame" Visible="False" VerticalAlignment="Top" MouseFilter="Ignore">
                <announce:RMCAnnouncementShaderRect Name="PortraitShader"/>
                <announce:RMCAnnouncementPortraitView Name="Portrait"/>
                <announce:RMCAnnouncementShaderRect Name="Crt"/>
            </PanelContainer>
            <BoxContainer Orientation="Vertical" SeparationOverride="4" VerticalAlignment="Top" MouseFilter="Ignore">
                <announce:RMCAnnouncementTextLabel Name="TitleLabel" Visible="False"/>
                <PanelContainer Name="TitleUnderline" Visible="False" MinHeight="2" HorizontalAlignment="Left" MouseFilter="Ignore"/>
                <announce:RMCAnnouncementTextLabel Name="BodyLabel"/>
                <BoxContainer Name="CenteredBody" Orientation="Vertical" Visible="False" MouseFilter="Ignore"/>
                <announce:RMCAnnouncementTextLabel Name="SpeakerLabel" Visible="False"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</Control>
