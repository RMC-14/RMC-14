<BoxContainer xmlns="https://spacestation14.io"
              xmlns:ui="clr-namespace:Content.Client.Options.UI"
              Orientation="Vertical">
    <ui:OptionSlider Name="MaxVisibleSlider" Title="{Loc 'rmc-ui-options-announcements-max-visible'}"/>
    <Label Text="{Loc 'rmc-ui-options-announcements-layout'}" StyleClasses="LabelKeyText"/>
    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
        <Button Name="EditLayoutButton" Text="{Loc 'rmc-ui-options-announcements-layout-open-editor'}"/>
        <Button Name="ResetLayoutButton" Text="{Loc 'rmc-ui-options-announcements-layout-reset-all'}"/>
    </BoxContainer>
    <RichTextLabel Name="LayoutSummaryLabel"/>
</BoxContainer>
