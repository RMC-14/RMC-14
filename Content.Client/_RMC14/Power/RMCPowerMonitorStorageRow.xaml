<controls:RMCPowerMonitorStorageRow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Power"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client._RMC14.UserInterface"
    HorizontalExpand="True"
    Margin="0 0 0 6">
    <PanelContainer.PanelOverride>
        <graphics:StyleBoxFlat
            BackgroundColor="#1A1A1A"
            BorderColor="#3A3A3A"
            BorderThickness="1" />
    </PanelContainer.PanelOverride>
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="5">
        <BoxContainer Orientation="Horizontal">
            <Label Name="StorageName" Access="Public" StyleClasses="LabelKeyText" />
            <Control HorizontalExpand="True" />
            <Label Name="StorageState" Access="Public" />
        </BoxContainer>
        <ProgressBar Name="ChargeBar" Access="Public" HorizontalExpand="True" MinValue="0" MaxValue="1">
            <Label Name="ChargeLabel" Access="Public" HorizontalAlignment="Center" Margin="0 3" />
        </ProgressBar>
        <ui:BlueHorizontalSeparator />
        <GridContainer Columns="2" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 0 10 0">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc rmc-power-monitor-input}" FontColorOverride="#7FAAD1" />
                    <Control HorizontalExpand="True" />
                    <Label Name="InputState" Access="Public" />
                </BoxContainer>
                <Label Name="InputPower" Access="Public" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="10 0 0 0">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc rmc-power-monitor-output}" FontColorOverride="#7FAAD1" />
                    <Control HorizontalExpand="True" />
                    <Label Name="OutputState" Access="Public" />
                </BoxContainer>
                <Label Name="OutputPower" Access="Public" />
            </BoxContainer>
        </GridContainer>
    </BoxContainer>
</controls:RMCPowerMonitorStorageRow>
