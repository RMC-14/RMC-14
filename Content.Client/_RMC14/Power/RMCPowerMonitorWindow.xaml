<controls:RMCPowerMonitorWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Power"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client._RMC14.UserInterface"
    Title=""
    MinSize="920 620">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat
                BackgroundColor="#141414"
                BorderColor="#3A3A3A"
                BorderThickness="1" />
        </PanelContainer.PanelOverride>

        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat
                        BackgroundColor="#252525"
                        BorderColor="#4972A1"
                        BorderThickness="0 0 0 2" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" Margin="8 5">
                    <Label Name="Connection" Access="Public" StyleClasses="LabelTitle" />
                    <Control HorizontalExpand="True" />
                    <Label Name="ConnectionState" Access="Public" />
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat
                        BackgroundColor="#1F1F1F"
                        BorderColor="#3A3A3A"
                        BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="5">
                    <Label Text="{Loc rmc-power-monitor-overview}" StyleClasses="LabelKeyText" />
                    <ui:BlueHorizontalSeparator />
                    <GridContainer Columns="3" HorizontalExpand="True">
                        <PanelContainer HorizontalExpand="True" Margin="0 0 3 3">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#192431" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="8 5">
                                <Label Text="{Loc rmc-power-monitor-available}" FontColorOverride="#7FAAD1" />
                                <Label Name="AvailableValue" Access="Public" StyleClasses="LabelBig" />
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer HorizontalExpand="True" Margin="3 0 3 3">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#192431" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="8 5">
                                <Label Text="{Loc rmc-power-monitor-generation}" FontColorOverride="#7FAAD1" />
                                <Label Name="GenerationValue" Access="Public" StyleClasses="LabelBig" />
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer HorizontalExpand="True" Margin="3 0 0 3">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#192431" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="8 5">
                                <Label Text="{Loc rmc-power-monitor-demand}" FontColorOverride="#7FAAD1" />
                                <Label Name="DemandValue" Access="Public" StyleClasses="LabelBig" />
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer HorizontalExpand="True" Margin="0 3 3 0">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#192431" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="8 5">
                                <Label Text="{Loc rmc-power-monitor-delivered}" FontColorOverride="#7FAAD1" />
                                <Label Name="DeliveredValue" Access="Public" StyleClasses="LabelBig" />
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer HorizontalExpand="True" Margin="3 3 3 0">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#192431" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="8 5">
                                <Label Text="{Loc rmc-power-monitor-deficit}" FontColorOverride="#7FAAD1" />
                                <Label Name="DeficitValue" Access="Public" StyleClasses="LabelBig" />
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer HorizontalExpand="True" Margin="3 3 0 0">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#192431" />
                            </PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="8 5">
                                <Label Text="{Loc rmc-power-monitor-surplus}" FontColorOverride="#7FAAD1" />
                                <Label Name="SurplusValue" Access="Public" StyleClasses="LabelBig" />
                            </BoxContainer>
                        </PanelContainer>
                    </GridContainer>
                </BoxContainer>
            </PanelContainer>

            <TabContainer Name="PowerTabs" Access="Public" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="ApcTab" Access="Public" Orientation="Vertical">
                    <PanelContainer HorizontalExpand="True" Margin="4 6 4 0">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat
                                BackgroundColor="#252525"
                                BorderColor="#4972A1"
                                BorderThickness="0 0 0 1" />
                        </PanelContainer.PanelOverride>
                        <GridContainer Columns="7" Margin="6 4">
                            <Label Text="{Loc rmc-power-monitor-area}" MinWidth="250" FontColorOverride="#7FAAD1" />
                            <Label Text="{Loc rmc-power-monitor-equipment}" MinWidth="75" Align="Center" FontColorOverride="#7FAAD1" />
                            <Label Text="{Loc rmc-power-monitor-lighting}" MinWidth="75" Align="Center" FontColorOverride="#7FAAD1" />
                            <Label Text="{Loc rmc-power-monitor-environment}" MinWidth="95" Align="Center" FontColorOverride="#7FAAD1" />
                            <Label Text="{Loc rmc-power-monitor-requested}" MinWidth="90" Align="Center" FontColorOverride="#7FAAD1" />
                            <Label Text="{Loc rmc-power-monitor-delivered}" MinWidth="90" Align="Center" FontColorOverride="#7FAAD1" />
                            <Label Text="{Loc rmc-power-monitor-cell}" MinWidth="120" Align="Center" FontColorOverride="#7FAAD1" />
                        </GridContainer>
                    </PanelContainer>
                    <Label Name="ApcEmpty" Access="Public" Text="{Loc rmc-power-monitor-no-apcs}"
                           Align="Center" StyleClasses="LabelBig" VerticalExpand="True" />
                    <ScrollContainer Name="ApcScroll" Access="Public" VerticalExpand="True"
                                     HorizontalExpand="True" HScrollEnabled="False" Margin="4 2 4 4">
                        <BoxContainer Name="ApcRows" Access="Public" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>

                <BoxContainer Name="StorageTab" Access="Public" Orientation="Vertical">
                    <Label Name="StorageEmpty" Access="Public" Text="{Loc rmc-power-monitor-no-storage}"
                           Align="Center" StyleClasses="LabelBig" VerticalExpand="True" />
                    <ScrollContainer Name="StorageScroll" Access="Public" VerticalExpand="True"
                                     HorizontalExpand="True" HScrollEnabled="False" Margin="4 6 4 4">
                        <BoxContainer Name="StorageRows" Access="Public" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
            </TabContainer>
        </BoxContainer>
    </PanelContainer>
</controls:RMCPowerMonitorWindow>
