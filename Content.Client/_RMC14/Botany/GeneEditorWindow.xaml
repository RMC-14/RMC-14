<botany:GeneEditorWindow
    xmlns="https://spacestation14.io"
    xmlns:botany="clr-namespace:Content.Client._RMC14.Botany"
    xmlns:ui="clr-namespace:Content.Client._RMC14.UserInterface"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MinSize="380 120"
    MaxWidth="720">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#1F2538" />
        </PanelContainer.PanelOverride>
        <TextureRect TexturePath="/Textures/_RMC14/Interface/Paper/paper_heading_weya.svg.96dpi.png"
                     ModulateSelfOverride="#FFFFFF18" Stretch="KeepCentered" MouseFilter="Ignore"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

        <ScrollContainer Margin="4" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False"
                         ReturnMeasure="True">
            <BoxContainer Orientation="Vertical">
                <!-- seed -->
                <PanelContainer Margin="0 0 0 4">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#00000054" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="6 5" SeparationOverride="4">
                        <PanelContainer Name="SeedBanner">
                            <BoxContainer Orientation="Horizontal" Margin="5 1">
                                <Label Name="SeedBannerLabel" FontColorOverride="White" Margin="0 0 6 0" />
                                <Label Name="SeedBannerDetail" FontColorOverride="#F3F6F5" HorizontalExpand="True" />
                            </BoxContainer>
                        </PanelContainer>

                        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                            <SpriteView Name="SeedSpriteView" Access="Public"
                                        SetSize="48 48"
                                        OverrideDirection="South"
                                        Scale="1.5 1.5"
                                        Stretch="Fit"
                                        VerticalAlignment="Center" />
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4"
                                          VerticalAlignment="Center">
                                <BoxContainer Name="EditCountRow" Orientation="Horizontal">
                                    <Label Text="Gene Edits:" MinWidth="80" FontColorOverride="#7D8EA6"
                                           VerticalAlignment="Center" />
                                    <ProgressBar Name="EditCountBar" HorizontalExpand="True" SetHeight="22"
                                                 VerticalAlignment="Center" MinValue="0" MaxValue="1">
                                        <Label Name="EditCountBarText" Align="Right" Margin="0 0 4 0"
                                               VerticalAlignment="Center" />
                                    </ProgressBar>
                                </BoxContainer>
                                <BoxContainer Name="SeedChips" Orientation="Horizontal" />
                                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                                    <ui:RMCMachineButton Name="ApplyButton" Access="Public" Text="Apply Genes" />
                                    <ui:RMCMachineButton Name="EjectButton" Access="Public" Text="Eject All" />
                                </BoxContainer>
                            </BoxContainer>
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>

                <!-- seed traits -->
                <PanelContainer Name="SeedTraitsCard" Margin="0 0 0 4">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#00000054" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical">
                        <Label Text="Seed Traits" StyleClasses="LabelKeyText" FontColorOverride="#FFFFFF" Margin="6 3" />
                        <PanelContainer MinHeight="2">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#000000" />
                            </PanelContainer.PanelOverride>
                        </PanelContainer>
                        <BoxContainer Name="SeedTraitRows" Orientation="Vertical" Margin="6 4 6 5" SeparationOverride="2" />
                    </BoxContainer>
                </PanelContainer>

                <!-- disc -->
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#00000054" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical">
                        <Label Text="Flora Data Disc" StyleClasses="LabelKeyText" FontColorOverride="#FFFFFF" Margin="6 3" />
                        <PanelContainer MinHeight="2">
                            <PanelContainer.PanelOverride>
                                <graphics:StyleBoxFlat BackgroundColor="#000000" />
                            </PanelContainer.PanelOverride>
                        </PanelContainer>
                        <BoxContainer Orientation="Vertical" Margin="6 4 6 5" SeparationOverride="2">
                            <botany:RMCBotanyInfoRow Name="DiscRow" />
                            <botany:RMCBotanyInfoRow Name="DiscSourceRow" />
                            <Label Name="NoDiscGenesLabel" Text="No genes stored on disc." FontColorOverride="#7D8EA6" />
                            <BoxContainer Name="DiscGenesContainer" Orientation="Vertical" SeparationOverride="2" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </ScrollContainer>
    </PanelContainer>
</botany:GeneEditorWindow>
