<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'rmc-fax-responder-rules-title'}"
                      SetSize="600 360">
    <BoxContainer Orientation="Vertical" Margin="20">
        <Label Text="{Loc 'rmc-fax-responder-rules-heading'}"
               StyleClasses="LabelBig"
               HorizontalAlignment="Center"
               Margin="0 0 0 10" />
        <PanelContainer StyleClasses="BackgroundDark" VerticalExpand="True" HorizontalExpand="True">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                <RichTextLabel Name="RulesLabel" Margin="10" />
            </ScrollContainer>
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="10" Margin="0 10 0 0">
            <Button Name="GuidebookButton"
                    Text="{Loc 'rmc-fax-responder-rules-guidebook'}"
                    MinWidth="150" />
            <Button Name="AcceptButton"
                    Disabled="True"
                    MinWidth="150" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
