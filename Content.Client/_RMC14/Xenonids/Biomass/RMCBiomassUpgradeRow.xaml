<controls:RMCBiomassUpgradeRow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Xenonids.Biomass"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client._RMC14.UserInterface"
    HorizontalExpand="True"
    MouseFilter="Pass">
    <BoxContainer Orientation="Horizontal" Margin="4 1" SeparationOverride="4">
        <BoxContainer Name="NameColumn" Orientation="Horizontal" SetWidth="336" SeparationOverride="4">
            <EntityPrototypeView Name="ItemView" SetSize="32 32" Stretch="Fit" VerticalAlignment="Center" />
            <Label Name="NameLabel" Access="Public" HorizontalExpand="True" ClipText="True" MouseFilter="Pass"
                   VerticalAlignment="Center" />
        </BoxContainer>
        <PanelContainer MinWidth="1" VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#000000" />
            </PanelContainer.PanelOverride>
        </PanelContainer>
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
            <BoxContainer Orientation="Horizontal">
                <PanelContainer Name="ClearancePanel" HorizontalAlignment="Left">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#00000000" BorderColor="#7D8EA6" BorderThickness="0 0 0 1" />
                    </PanelContainer.PanelOverride>
                    <Label Name="ClearanceLabel" Access="Public" />
                </PanelContainer>
                <Control HorizontalExpand="True" />
                <Label Name="CostLabel" Access="Public" />
            </BoxContainer>
            <Label Name="TrendLabel" Access="Public" />
        </BoxContainer>
        <PanelContainer MinWidth="1" VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#000000" />
            </PanelContainer.PanelOverride>
        </PanelContainer>
        <BoxContainer Name="PrintColumn" Orientation="Vertical" SetWidth="170" SeparationOverride="1"
                      VerticalAlignment="Center">
            <ui:RMCMachineButton Name="PrintButton" Access="Public" HorizontalExpand="True" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="1">
                <ui:RMCMachineButton Name="Print2Button" Access="Public" Text="x2" HorizontalExpand="True" TextAlign="Center" />
                <ui:RMCMachineButton Name="Print5Button" Access="Public" Text="x5" HorizontalExpand="True" TextAlign="Center" />
                <ui:RMCMachineButton Name="Print10Button" Access="Public" Text="x10" HorizontalExpand="True" TextAlign="Center" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:RMCBiomassUpgradeRow>
