<cc:RenegadeDefectionOfferWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client._RMC14.Xenonids.Hive"
    Title="Alliance broken!"
    MinSize="360 220">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <RichTextLabel Name="MessageLabel" Access="Public" MaxWidth="340" />
        <Label Name="CountdownLabel" Access="Public" HorizontalAlignment="Center" />
        <Control VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8" Margin="0 4 0 0">
            <Button Name="StayButton" Access="Public" MinHeight="35" HorizontalExpand="True"
                    Text="Obey the Queen" StyleClasses="ButtonColorDefaultRed" />
            <Button Name="DefectButton" Access="Public" MinHeight="35" HorizontalExpand="True"
                    Text="Obey the talls" StyleClasses="ButtonColorGreen" />
        </BoxContainer>
    </BoxContainer>
</cc:RenegadeDefectionOfferWindow>
