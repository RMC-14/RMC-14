<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    HorizontalExpand="True"
    Orientation="Vertical">

    <!-- Save and reset buttons up top -->
    <BoxContainer Orientation="Horizontal" SetHeight="64" HorizontalAlignment="Center" Margin="0 5">
        <Button Name="SaveButton" StyleClasses="ButtonBig" Margin="10 0" MinSize="120 40"
                Text="{Loc 'humanoid-profile-editor-save-button'}"/>
        <Button Name="ResetButton" StyleClasses="ButtonBig" Margin="10 0" MinSize="120 40"
                Text="{Loc 'humanoid-profile-editor-reset-button'}"/>
    </BoxContainer>

    <!-- We stuff the priority selectors in here -->
    <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical">
            <!-- RMC14 -->
            <BoxContainer Orientation="Vertical" Margin="0 0 0 23">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#464966" />
                    </PanelContainer.PanelOverride>
                    <Label Text="{Loc 'rmc-job-priority-editor-player-settings'}" Margin="5 0 0 0" />
                </PanelContainer>
                <BoxContainer Orientation="Vertical" Margin="5 5 5 0">
                    <OptionButton Name="PreferenceUnavailableButton" HorizontalAlignment="Left" />
                    <BoxContainer HorizontalExpand="True" Margin="0 5 0 0">
                        <Label Text="{Loc 'humanoid-profile-editor-enable-playtime-perks'}" />
                        <Control HorizontalExpand="True" />
                        <Button Name="PlaytimePerksButton" ToggleMode="True" Pressed="True"
                                Text="{Loc 'humanoid-profile-editor-enable'}" />
                    </BoxContainer>
                    <BoxContainer HorizontalExpand="True" Margin="0 5 0 0">
                        <Label Text="{Loc 'humanoid-profile-editor-xeno-prefix'}"
                               ToolTip="{Loc 'humanoid-profile-editor-xeno-prefix-tooltip'}"
                               MouseFilter="Stop" />
                        <Control HorizontalExpand="True" />
                        <LineEdit Name="XenoPrefix" MinWidth="100" />
                    </BoxContainer>
                    <BoxContainer HorizontalExpand="True" Margin="0 5 0 0">
                        <Label Text="{Loc 'humanoid-profile-editor-xeno-postfix'}"
                               ToolTip="{Loc 'humanoid-profile-editor-xeno-postfix-tooltip'}"
                               MouseFilter="Stop" />
                        <Control HorizontalExpand="True" />
                        <LineEdit Name="XenoPostfix" MinWidth="100" />
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
            <!-- RMC14 -->
            <BoxContainer Name="JobList" Orientation="Vertical" />
        </BoxContainer>
    </ScrollContainer>
</BoxContainer>
