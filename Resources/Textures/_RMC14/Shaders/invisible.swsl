light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform highp float opacity; // number between 0 and 1
uniform highp float grey_factor; // number between 0 and 1
uniform highp float dark_factor; // number between 0 and 1

void fragment() {

    highp vec4 sprite = zTexture(UV);

    if (sprite.a == 0.0) {
        discard;
    }

    highp vec3 rgb = sprite.rgb;

    rgb = mix(rgb, vec3(zGrayscale(rgb)), clamp(grey_factor, 0.0, 1.0));
    rgb = mix(rgb, vec3(0.0), clamp(dark_factor, 0.0, 1.0));

    COLOR.rgb = rgb;
    COLOR.a = sprite.a * clamp(opacity, 0.0, 1.0);
}
