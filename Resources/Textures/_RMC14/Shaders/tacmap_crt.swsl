light_mode unshaded;

uniform sampler2D overlay_texture;
uniform highp vec2 overlay_scale;
uniform lowp float overlay_strength;

void fragment() {
    lowp vec4 base = zTexture(UV);
    if (base.a <= 0.0) {
        COLOR = vec4(0.0);
        return;
    }

    highp vec2 tileCoord = UV / TEXTURE_PIXEL_SIZE;
    lowp vec4 overlay = texture2D(overlay_texture, fract(tileCoord * overlay_scale));
    lowp float amount = clamp(overlay.a * overlay_strength, 0.0, 1.0);
    COLOR = vec4(mix(base.rgb, overlay.rgb, amount), base.a);
}
