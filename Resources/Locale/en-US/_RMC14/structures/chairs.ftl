rmc-chair-stack-name = stack of folding chairs
rmc-chair-stack-description = A precarious tower of {$count} folding chairs.

rmc-chair-stack-add = You add {$chair} to the stack.
rmc-chair-stack-unstable = The stack of chairs looks unstable!
rmc-chair-stack-remove = You take {$chair} from the stack.
rmc-chair-stack-collapse = {$tower} collapses with a deafening crash!

rmc-chair-stack-invalid = Only a folded, unwielded chair can be added to an unfolded chair stack.
rmc-chair-stack-occupied = You cannot stack chairs while the chair or its tile is occupied.
rmc-chair-stack-cant-fold = You cannot fold the base while chairs are stacked on it.
rmc-chair-stack-cant-buckle = You cannot buckle anyone to a stack of chairs.
rmc-chair-stack-cant-dismantle = Remove the stacked chairs before dismantling the base.
