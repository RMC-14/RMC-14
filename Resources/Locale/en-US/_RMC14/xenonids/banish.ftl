# Manage Hive Options
rmc-hivemanagement-banish = Banish Xenonid
rmc-hivemanagement-readmit = Readmit Xenonid

# Banish System
rmc-banish-title = Banishment
rmc-banish-confirm = Enter a reason for banishing {$name}:
rmc-banish-no-valid-targets = There are no xenonids that can be banished.
rmc-banish-rules = Banishment Rules:
    You can banish any xenonid that does not follow the xenonid roleplay, expectations or refuses to follow orders after multiple attempts to command them.
    Abuse of banishment may result in admin action.

# Banish Errors
rmc-banish-error-not-enough-playtime = You need at least {$requiredHours} hours of Queen playtime to banish xenonids.
rmc-banish-already-banished = This xenonid is already banished!
rmc-banish-different-hive = This xenonid doesn't belong to your hive!
rmc-banish-not-xeno = Target is not a xenonid.
rmc-banish-crit = You cannot banish a xenonid that is in critical condition.
rmc-banish-no-reason = You must provide a reason for the banishment.

# Readmit System
rmc-readmit-title = Readmission
rmc-readmit-confirm = Are you sure you want to readmit {$name} to the hive?
rmc-readmit-no-valid-targets = There are no banished xenonids to readmit.
rmc-readmit-option-wait = {$name} (wait {$minutes} min)
rmc-readmit-wait = You must wait {$minutes} more minutes before readmitting this xenonid.
rmc-readmit-not-banished = This xenonid is not banished.
rmc-readmit-dead = You cannot readmit a dead xenonid.
rmc-readmit-different-hive = This xenonid wasn't banished from your hive!
rmc-readmit-admin-verb = Readmit to hive

# Evolution Prevention
rmc-xeno-evolution-failed-banished = You cannot evolve while banished from the hive.

# Announcements
rmc-banish-announcement = {$name} has been banished from the hive. Reason: {$reason}
rmc-banish-notification = You have been banished from the hive! Reason: {$reason}
rmc-readmit-announcement = {$name} has been readmitted to the hive.
rmc-readmit-notification = You have been readmitted to the hive!
